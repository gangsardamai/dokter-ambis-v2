{
  "name": "dokter-ambis-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:leader": "node tests/leader/verify.mjs && node --experimental-strip-types tests/leader/routes.mjs && node tests/leader/tryout.mjs",
